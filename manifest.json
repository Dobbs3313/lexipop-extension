{
  "manifest_version": 3,
  "name": "LexiPop — Instant Dictionary & Wordbook",
  "short_name": "LexiPop",
  "description": "Privacy-first double-click dictionary with IPA phonetics, audio pronunciation, adjustable typography, and Anki/CSV Wordbook export.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LexiPop Dictionary",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
